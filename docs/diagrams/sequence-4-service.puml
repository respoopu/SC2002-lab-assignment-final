@startuml sequence-4-service
!include style.iuml
title Recovery, READY, SERVED and payment (4 of 4)
mainframe sd ServeAndPay
hide footbox
participant "controller :\nTurnController" as TC <<control>>
participant "c3 :\nRegularCustomer" as C3
participant "o3 : Order" as O3
participant "chef : Chef" as Chef
participant "waiter : Waiter" as W
participant "cashier : Cashier" as Cashier
participant "state : GameState" as S
participant "t1 : Table" as T1
autonumber
activate TC
note over TC, T1
  Expands PlayGame's beginTurn / submit / endTurn calls across turns 8-12.
  Controller activation spans selected excerpts; UI entries/returns are omitted.
  At turn-7 end C3 loses 8 -> 92. C2 pays, freeing T2. O3 is PREPARING 1/3.
end note
== turn 8 beginTurn: Happy Hour remaining 1 ==
TC -> C3 ++ : recover(15)
C3 --> TC -- : 100 (actual increase 8)
loop turns 8 and 9; Host WAIT, Waiter WAIT, Chef PREPARE O3
  TC -> Chef ++ : prepare(state, "O3")
  Chef -> O3 ++ : advanceOneUnit(turn)
  O3 --> Chef -- : void
  Chef --> TC -- : accepted progress / READY event
  note over C3, O3
    Turn 8: 2/3 units. Turn 9: READY, readyTurn = 9.
    Turn 9 beginTurn has remaining 0, so no recovery.
  end note
  TC -> C3 ++ : loseSatisfaction() [endTurn]
  C3 --> TC -- : 92 on turn 8; 84 on turn 9
end
== turn 10: Host seats C4 at T2; Waiter SERVE O3 ==
TC -> W ++ : serve(state, "O3")
note right of W : Guard: READY and readyTurn 9 < current turn 10.
W -> C3 ++ : startEating(10)
C3 --> W -- : void
W -> O3 ++ : markServed(10)
O3 --> W -- : void
W -> S ++ : recordServed()
S --> W -- : void
W --> TC -- : accepted; O3 served to C3
note over TC, O3
  EATING / SERVED; no waiting loss. Satisfaction stays 84.
  endTurn on turn 10 cannot finish eating: servedTurn == current turn.
end note
== turn 11 endTurn: finish one full eating turn ==
TC -> C3 ++ : becomeReadyToPay(11)
C3 --> TC -- : void
note right of C3 : READY_TO_PAY; readyToPayTurn = 11.
TC -> Cashier ++ : collect(state)
Cashier --> TC -- : empty; C3 is not eligible until readyToPayTurn < turn
== turn 12 endTurn: oldest eligible payment ==
TC -> Cashier ++ : collect(state)
note right of Cashier : C3: readyToPayTurn 11 < 12.\nTie-break: ready turn, arrival turn, arrival index.
Cashier -> O3 ++ : markPaid()
O3 --> Cashier -- : void
Cashier -> C3 ++ : pay()
C3 --> Cashier -- : void
Cashier -> T1 ++ : release()
T1 --> Cashier -- : void
Cashier -> S ++ : recordPayment(1944, 84)
S --> Cashier -- : void
Cashier --> TC -- : C3 paid $19.44 (satisfaction 84), T1 free
note over TC, S : Cumulative: 4194 cents, 3 paid. O3 and C3 are PAID; bill still 1944.
note over TC, T1
  Eligibility checks and routine accessor calls are omitted.
  Other customers use the same methods: C4 pays on 15 and C5 on 17.
  PlayGame continues to endTurn on turn 18, integer result checks and VICTORY.
  All-WAIT alternative ends DEFEAT. READY 9 -> SERVED 10 -> READY_TO_PAY 11 -> PAID 12.
end note
deactivate TC
@enduml
