@startuml class-domain
!include style.iuml
!pragma layout smetana
top to bottom direction
title Stage 3 | Domain objects (1 of 3)

  abstract class Customer {
    -id : String
    -arrivalTurn : int
    -arrivalIndex : int
    -status : CustomerStatus
    -satisfaction : int
    -order : Order
    -servedTurn : int
    -readyToPayTurn : int
    {abstract} +typeName() : String
    {abstract} +waitingLossPerTurn() : int
    {abstract} +discountPercent() : int
    {abstract} +chooseMeal(menu: Menu) : MenuItem
    +seat() : void
    +attachOrder(order: Order) : void
    +startEating(turn: int) : void
    +becomeReadyToPay(turn: int) : void
    +pay() : void
    +leave() : void
    +loseSatisfaction() : int
    +recover(amount: int) : int
  }
  class RegularCustomer {
    +waitingLossPerTurn() : int
    +discountPercent() : int
    +chooseMeal(menu: Menu) : MenuItem
  }
  class VIPCustomer {
    +waitingLossPerTurn() : int
    +discountPercent() : int
    +chooseMeal(menu: Menu) : MenuItem
  }
  class CriticCustomer {
    +waitingLossPerTurn() : int
    +discountPercent() : int
    +chooseMeal(menu: Menu) : MenuItem
  }
  class WaitingQueue {
    -customers : List<Customer>
    +add(customer: Customer) : void
    +find(id: String) : Optional<Customer>
    +remove(id: String) : Customer
    +view() : List<Customer>
  }
  enum CustomerStatus {
    WAITING
    SEATED
    EATING
    READY_TO_PAY
    PAID
    LEFT
  }

  class Menu {
    -items : List<MenuItem>
    +{static} base() : Menu
    +items() : List<MenuItem>
    +item(name: String) : MenuItem
    +cycleChoice(arrivalIndex: int) : MenuItem
  }
  class MenuItem {
    -name : String
    -priceCents : int
    -preparationUnits : int
    +priceCents() : int
    +preparationUnits() : int
  }
  class ComboMeal {
    -first : MenuItem
    -second : MenuItem
    +ComboMeal(name: String, first: MenuItem, second: MenuItem)
    +first() : MenuItem
    +second() : MenuItem
  }
  class Order {
    -id : String
    -customerId : String
    -item : MenuItem
    -billCents : int
    -status : OrderStatus
    -unitsDone : int
    -readyTurn : int
    -servedTurn : int
    +advanceOneUnit(turn: int) : void
    +markServed(turn: int) : void
    +markPaid() : void
    +cancel() : void
  }
  class Money <<utility, final>> {
    +{static} applyDiscount(cents: int, percentOff: int) : int
    +{static} format(cents: int) : String
  }
  enum OrderStatus {
    PLACED
    PREPARING
    READY
    SERVED
    PAID
    CANCELLED
  }

  class Table {
    -id : String
    -occupantId : String
    +isFree() : boolean
    +seat(customerId: String) : void
    +release() : void
  }

Customer <|-- RegularCustomer
Customer <|-- VIPCustomer
Customer <|-- CriticCustomer
MenuItem <|-- ComboMeal
Customer "1" -right-> "0..1" Order : order
Customer --> CustomerStatus : status
Order --> OrderStatus : status
Order "0..*" --> "1" MenuItem : item
Menu "0..*" o-- "3..*" MenuItem : items
ComboMeal "0..*" o-- "1..2" MenuItem : first, second
WaitingQueue "0..1" --> "0..*" Customer : queued subset
Order ..> Money : locks discounted bill
ComboMeal ..> Money : 10% off component sum
Table ..> Customer : occupantId (ID lookup; 0..1 occupant)

legend bottom left
  + public; - private. Italic operations are abstract; underlined operations are static.
  Solid arrow = retained reference; dashed = call or explicit ID lookup.
  Shared aggregation: ComboMeal has two references (first/second) to 1..2 distinct items.
  Encapsulation: Customer owns transitions/satisfaction; Order owns progress and the locked bill.
  Polymorphism: Regular loss8/cycle-or-combo; VIP loss5/10%/cycle; Critic loss12/Pasta.
  GameState owns the queue/tables; its relationships are in view 3.
  Packages: customer (customers/queue/status), menu (catalog/items/order/money/status), staff (Table).
endlegend
@enduml
