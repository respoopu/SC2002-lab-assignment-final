@startuml sequence-2-arrival
!include style.iuml
title Stage 3 | Turn 7: activate, arrive and seat (2 of 4)
hide footbox
participant "ui : ConsoleUI" as UI <<boundary>>
participant "controller : TurnController" as TC <<control>>
participant "state : GameState" as State
participant "arrivals : IntFunction<Customer>" as Factory
participant "c3 : RegularCustomer" as C3
participant "host : Host" as Host
participant "Seating (static)" as Seating
participant "t1 : Table" as T1
autonumber

note over UI, T1
  Entry: turn 6 complete. C1 PAID; C2 READY_TO_PAY at T2. T1 is free.
  UI parsed HAPPY_HOUR. Wrong phase/reuse is rejected before any mutation.
end note
group beginTurn(true): valid TURN_START, unused Happy Hour
  UI -> TC ++ : beginTurn(true)
  TC -> State : setTurn(7)
  TC -> State : activateHappyHour()
  note right of State : happyHourTurn = 7; remaining = 2.
  note left of TC : Adds "Happy Hour activated" to local events.
  note over TC, C3
    recoverWaitingCustomers calls recover(15) on existing C1/C2.
    Their PAID/READY_TO_PAY states exclude recovery. C3 is not created yet.
  end note
  TC -> Factory : apply(3)
  note right of Factory
    Lambda calls GameSetup.arrival(3, 7):
    new RegularCustomer("C3", 7, 3).
  end note
  Factory --> TC : c3 (WAITING, satisfaction 100)
  TC -> State : addCustomer(c3); queue().add(c3)
  note left of TC : Adds "C3 (Regular) arrives" to local events.
  TC -> State : setPhase(HOST)
  TC --> UI -- : TurnStart: activation then arrival event; remaining 2
end
group Host action: queued ID and free table required
  UI -> TC ++ : submit(Action(HOST, SEAT, "C3"))
  TC -> Host ++ : seat(state, "C3")
  Host -> Seating ++ : seat(state, "C3")
  Seating -> Seating : firstFreeTable(state)
  Seating -> State : queue().remove("C3")
  Seating -> T1 : seat("C3")
  Seating -> C3 : seat()
  note right of C3 : WAITING -> SEATED; satisfaction 100.
  Seating --> Host -- : accepted; C3 seated at T1
  Host --> TC -- : ActionResult
  TC -> State : setPhase(WAITER)
  TC --> UI -- : accepted ActionResult
end
note over UI, T1
  Failed seating preconditions return rejected before effects; phase remains HOST.
  Host and Waiter share Seating. Page 3 continues with ORDER C3 in this same turn.
end note
@enduml
