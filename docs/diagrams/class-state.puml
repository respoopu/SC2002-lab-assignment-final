@startuml class-state
!include style.iuml
!pragma layout smetana
title State and message values (3 of 3)

class GameState <<entity>> {
  -config : GameConfig
  -queue : WaitingQueue
  -tables : List<Table>
  -customers : List<Customer>
  -orders : List<Order>
  -menu : Menu
  -turn : int
  -phase : Phase
  -happyHourTurn : int
  -paidCount : int
  -revenueCents : int
  -satisfactionSum : int
  +happyHourUsed() : boolean
  +happyHourActive() : boolean
  +happyHourRemaining() : int
  +recordPayment(cents: int, satisfaction: int) : void
  ~activateHappyHour() : void
}
class GameConfig <<record>> {
  -turns : int
  -tableCount : int
  -arrivalTurns : List<Integer>
  +{static} base() : GameConfig
}
class WaitingQueue <<domain view>>
class Table <<domain view>>
class Snapshot <<record>> {
  -turn : int
  -phase : Phase
  -customers : List<CustomerView>
  -queue : List<CustomerView>
  -tables : List<TableView>
  -orders : List<OrderView>
  -legalActions : List<Action>
  -happyHourAvailable : boolean
  -happyHourRemaining : int
}
class Action <<record>> {
  -role : StaffRole
  -kind : ActionKind
  -targetId : String
}
class ActionResult <<record>> {
  -accepted : boolean
  -message : String
  -events : List<GameEvent>
}
class TurnEnd <<record>> {
  -events : List<GameEvent>
  -summary : TurnSummary
  -result : Optional<GameResult>
}
enum Phase {
  TURN_START
  HOST
  WAITER
  CHEF
  TURN_END
  GAME_OVER
}
enum StaffRole {
  HOST
  WAITER
  CHEF
}
enum ActionKind {
  SEAT
  ORDER
  SERVE
  PREPARE
  WAIT
}
enum GameResult {
  VICTORY
  DEFEAT
}
GameState "1" *-- "1" WaitingQueue : creates
GameState "1" *-- "0..*" Table : creates
GameState "1" --> "1" GameConfig : config
GameState --> Phase : phase
Snapshot --> Phase : phase
Snapshot "1" --> "0..*" Action : legalActions
Action --> StaffRole : role
Action --> ActionKind : kind
TurnEnd --> GameResult : optional result
ActionResult -[hidden]right-> TurnEnd

legend bottom left
  GameState stores live domain references; Snapshot carries copied view records, not live objects.
  Black diamonds = internally created lifetime-owned parts (two Tables in the base setting).
  Record fields are private/final; generated accessors are public. List values are copied defensively.
  TurnStart, TurnSummary, GameEvent and the three *View records are supporting return values.
  All types are in game except WaitingQueue (customer) and Table (staff).
endlegend
@enduml
